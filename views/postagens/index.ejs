<head>
    <%- include('../head'); %>
</head>

<body class="bg-gradient-to-b from-[#e0fcff] to-white min-h-screen flex flex-col">

    <header>
        <%- include('../menu'); %>
    </header>

    <main class="flex-1 max-w-6xl w-full mx-auto px-6 py-10">

        <!-- Título -->
        <section class="mb-10">

            <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-5">

                <div>
                    <h1 class="font-serif text-4xl text-[#127fbf] tracking-wide">
                        Postagens de <%= nomeEsporte %>
                    </h1>

                    <div class="w-full h-[2px] bg-[#127fbf] mt-3"></div>

                    <p class="text-gray-600 font-sans mt-3">
                        Confira as últimas notícias e publicações sobre <%= nomeEsporte %>.
                    </p>
                </div>

                <!-- Criar postagem -->
                <a href="/criarPostagem/<%= esporte %>"
                    class="shrink-0 bg-[#ffe58f] text-black px-5 py-3 rounded-lg
                    font-medium border-2 border-black
                    shadow-[3px_3px_0px_rgba(0,0,0,1)]
                    hover:translate-x-[2px] hover:translate-y-[2px]
                    hover:shadow-[1px_1px_0px_rgba(0,0,0,1)]
                    transition-all">

                    + Criar postagem

                </a>

            </div>

        </section>


        <% if (postagens.length === 0) { %>

            <!-- Nenhuma postagem -->
            <div class="bg-[#f4edd7] rounded-2xl shadow-lg p-10 text-center">

                <h2 class="font-serif text-2xl text-[#127fbf] mb-2">
                    Nenhuma postagem encontrada
                </h2>

                <p class="text-gray-600">
                    Ainda não existem postagens para este esporte.
                </p>

            </div>

        <% } else { %>

            <!-- Lista de postagens -->
            <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

                <% postagens.forEach(postagem => { %>

                    <article
                        class="bg-[#f4edd7] rounded-2xl shadow-lg overflow-hidden
                        border-2 border-transparent hover:border-[#127fbf]
                        transition-all duration-200 hover:-translate-y-1">

                        <!-- Imagem -->
                        <% if (postagem.imagem) { %>

                            <div class="w-full h-48 overflow-hidden">
                                <img
                                    src="/imagens/<%= postagem.imagem %>"
                                    alt="<%= postagem.titulo %>"
                                    class="w-full h-full object-cover">
                            </div>

                        <% } else { %>

                            <div
                                class="w-full h-48 bg-[#127fbf] flex items-center justify-center">

                                <span class="text-[#f4edd7] font-serif text-2xl">
                                    <%= nomeEsporte %>
                                </span>

                            </div>

                        <% } %>


                        <!-- Conteúdo -->
                        <div class="p-5 flex flex-col">

                            <span
                                class="text-sm text-[#127fbf] font-semibold uppercase tracking-wide mb-2">
                                <%= nomeEsporte %>
                            </span>

                            <h2
                                class="font-serif text-2xl text-black mb-3">
                                <%= postagem.titulo %>
                            </h2>

                            <p class="text-gray-700 font-sans leading-relaxed">
                                <%= postagem.descricao %>
                            </p>

                            <!-- Data -->
                            <div class="mt-5 pt-4 border-t border-black/20">

                                <span class="text-sm text-gray-600">
                                    <%= new Date(postagem.creat_at).toLocaleDateString('pt-BR') %>
                                </span>

                            </div>

                            <!-- Botão -->
                            <button
                                class="mt-4 w-full bg-[#127fbf] text-[#f4edd7]
                                py-2 rounded-lg font-medium
                                shadow-[2px_2px_0px_rgba(0,0,0,1)]
                                hover:translate-x-[1px] hover:translate-y-[1px]
                                hover:shadow-[1px_1px_0px_rgba(0,0,0,1)]
                                transition-all">

                                Ler postagem

                            </button>

                        </div>

                    </article>

                <% }) %>

            </section>

        <% } %>

    </main>

    <%- include('../mensagens') %>

</body>