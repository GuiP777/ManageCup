
<!DOCTYPE html>
<html lang="pt-br">

<head>
    <%- include('../head'); %>
</head>

<body class="bg-gradient-to-b from-[#e0fcff] to-white min-h-screen flex flex-col">

    <header>
        <%- include('../menu'); %>
    </header>

    <main class="flex-1 flex justify-center items-start pt-18 font-serif p-6">

        <div class="bg-[#1a83b8] w-full max-w-4xl rounded-xl p-8 shadow-lg">

            <h1 class="text-[#f4edd7] text-4xl font-semibold mb-8">
                Criar uma Postagem
            </h1>

            <form action="/criarPostagem/<%= esporte %>" method="POST" enctype="multipart/form-data"
                class="flex flex-col gap-y-5 text-[#f4edd7]">


                <!-- Mensagem -->
                <div class="flex flex-col">

                    <label for="mensagem" class="mb-1 text-[1.1rem]">
                        Mensagem
                    </label>

                    <textarea id="mensagem" name="mensagem" rows="5" required
                        placeholder="Compartilhe algo sobre o esporte..."
                        class="bg-[#f4edd7] text-black rounded-md px-3 py-2
                        focus:outline-none shadow-sm w-full resize-none"></textarea>

                </div>

                <!-- Imagem opcional -->
                <div class="flex flex-col items-start">

                    <span class="mb-1 text-[1.1rem]">
                        Imagem (opcional)
                    </span>

                    <label class="cursor-pointer mt-2">

                        <img src="/imagens/iconeBaixar.png"
                            class="size-10 cursor-pointer">

                        <input type="file" name="imagem" accept="image/*"
                            class="hidden">

                    </label>

                </div>

                <!-- Botão -->
                <div class="flex justify-center mt-4">

                    <button type="submit"
                        class="w-1/2 h-12 font-sans text-lg cursor-pointer bg-[#c24e54]
                        text-white font-semibold border-2 border-black rounded-lg
                        hover:bg-[#a63f44]
                        shadow-[2px_2px_0px_rgba(0,0,0,1)]
                        hover:shadow-none hover:translate-y-[2px]
                        hover:translate-x-[2px]">

                        Criar Postagem

                    </button>

                </div>

            </form>

        </div>

    </main>

    <%- include('../mensagens') %>

</body>

</html>