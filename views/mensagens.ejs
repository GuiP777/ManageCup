<% if(mensagem){ %>
    <div id="mensagem" class="fixed top-5 right-5 z-50 min-w-[320px] max-w-[400px]
    px-5 py-4 rounded-xl shadow-2xl text-white
    flex items-center justify-between gap-4
    animate-slideIn

    <%= mensagem.tipo === 'sucesso'
        ? 'bg-green-500'
        : mensagem.tipo === 'erro'
        ? 'bg-red-500'
        : 'bg-blue-500'
    %>
">

        <div>
            <p class="font-semibold">
                <%= mensagem.texto %>
            </p>
        </div>

        <button onclick="fecharMensagem()" class="text-2xl leading-none hover:scale-110 transition">
            &times;
        </button>

    </div>

    <script>

        const mensagem = document.getElementById('mensagem');

        function fecharMensagem() {

            mensagem.classList.add('opacity-0', 'translate-x-10');

            setTimeout(() => {
                mensagem.remove();
            }, 300);
        }

        setTimeout(() => {

            if (mensagem) {

                fecharMensagem();

            }

        }, 4000);

    </script>

    <% } %>
        <style>
            @keyframes slideIn {

                from {
                    opacity: 0;
                    transform: translateX(100%);
                }

                to {
                    opacity: 1;
                    transform: translateX(0);
                }

            }

            .animate-slideIn {

                animation: slideIn 0.4s ease;

            }
        </style>