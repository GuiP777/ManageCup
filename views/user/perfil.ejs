<!DOCTYPE html>
<html lang="pt-br">

<head> <%- include('../head'); %> </head>

<body class="bg-gradient-to-b from-[#e0fcff] to-white min-h-screen flex flex-col">
    <header> <%- include('../menu'); %> </header>
    <div class=" p-8 flex-1 flex justify-center items-start">

        <div class="bg-[#127fbf] rounded-xl p-10 w-full max-w-3xl shadow-md font-serif text-[#f4edd7]">

            <h2 class="text-4xl mb-6 tracking-wide text-[#f4edd7]">Informações pessoais</h2>

            <div class="ml-8 space-y-1 text-lg text-[#f4edd7]">
                <div>
                    <span class="tracking-wide">Nome:</span>
                    <span class="text-black font-sans text-sm ml-1">
                        <%= dados.nome %>
                    </span>
                </div>
                <div>
                    <span class="tracking-wide">Email:</span>
                    <span class="text-black font-sans text-sm ml-1">
                        <%= dados.email %>
                    </span>
                </div>
                <div>
                    <span class="tracking-wide">Nascimento:</span>
                    <span class="text-black font-sans text-sm ml-1">
                        <%= dados.nascimento.toLocaleDateString('pt-BR', { 
                            day: '2-digit' , 
                            month: 'long' ,
                            year: 'numeric' }) %>
                    </span>
                </div>
                <div>
                    <span class="tracking-wide">Sexo:</span>
                    <span class="text-black font-sans text-sm ml-1">
                        <%= dados.sexo %>
                    </span>
                </div>
                <% if(dados.perfilVoleibolTreinador != null){ %>
                <div>
                    <span class="tracking-wide">Nome da Equipe:</span>
                    <span class="text-black font-sans text-sm ml-1">
                        <%= dados.perfilVoleibolTreinador.nomeEquipe%>
                    </span>
                </div>
                <div>
                    <span class="tracking-wide">Categoria:</span>
                    <span class="text-black font-sans text-sm ml-1">
                        <%= dados.perfilVoleibolTreinador.categoria %>
                    </span>
                </div>
                <% } %>

                <% if(dados.perfilVoleibolJogador != null){ %>
                <div>
                    <span class="tracking-wide">Posição:</span>
                    <span class="text-black font-sans text-sm ml-1">
                        <%= dados.perfilVoleibolJogador.posicao%>
                    </span>
                </div>
                <div>
                    <span class="tracking-wide">Altura:</span>
                    <span class="text-black font-sans text-sm ml-1">
                        <%= dados.perfilVoleibolJogador.tamanho %>
                    </span>
                </div>
                <div>
                    <span class="tracking-wide">Tempo Jogando:</span>
                    <span class="text-black font-sans text-sm ml-1">
                        <%= dados.perfilVoleibolJogador.tempo %>
                    </span>
                </div>
                <% } %>

                <% if(dados.perfilBoxe != null){ %>
                <div>
                    <span class="tracking-wide">Apelido:</span>
                    <span class="text-black font-sans text-sm ml-1">
                        <%= dados.perfilBoxe.apelido%>
                    </span>
                </div>
                <div>
                    <span class="tracking-wide">Peso:</span>
                    <span class="text-black font-sans text-sm ml-1">
                        <%= dados.perfilBoxe.peso %>
                    </span>
                </div>
                <div>
                    <span class="tracking-wide">Treinador:</span>
                    <span class="text-black font-sans text-sm ml-1">
                        <%= dados.perfilBoxe.treinador %>
                    </span>
                </div>
                <div>
                    <span class="tracking-wide">Quantidade de lutas:</span>
                    <span class="text-black font-sans text-sm ml-1">
                        <%= dados.perfilBoxe.quantidadeLutas %>
                    </span>
                </div>
                <% } %>

                <% if(dados.perfilCorrida != null){ %>
                <div>
                    <span class="tracking-wide">Recorde pessoal:</span>
                    <span class="text-black font-sans text-sm ml-1">
                        <%= dados.perfilCorrida.recordePessoal%>
                    </span>
                </div>
                <div>
                    <span class="tracking-wide">Nivel:</span>
                    <span class="text-black font-sans text-sm ml-1">
                        <%= dados.perfilCorrida.nivel %>
                    </span>
                </div>
                <% } %>
            </div>

            <h2 class="text-4xl mt-6 mb-6 tracking-wide text-[#f4edd7]">Complete seu perfil</h2>

            <div class="ml-8">
                <p class="text-xl mb-6 tracking-wide text-[#f4edd7]">Qual (s) esporte você quer competir?</p>

                <form action="/atualiza_perfil_boxe" method="POST" class="flex flex-col space-y-4">

                    <label class="flex items-center space-x-3 cursor-pointer w-max">
                        <input type="checkbox" id="check-boxe" name="esporte" value="boxe" class="appearance-none w-7 h-7 bg-[#f4edd7] rounded cursor-pointer 
                            checked:bg-[#f4edd7] checked:ring-2 checked:ring-green-500 flex items-center 
                            justify-center relative after:content-[''] after:hidden checked:after:block 
                            after:w-2.5 after:h-4 after:border-r-4 after:border-b-4 after:border-green-500 
                            after:rotate-45 after:-mt-1">
                        <span class="text-xl tracking-wide">Boxe</span>
                    </label>

                    <div id="campos-boxe" class="hidden flex-col space-y-4 ml-8 mt-2 w-full max-w-md text-[#ff8a8a]">

                        <div class="flex flex-col">
                            <label for="apelido" class="text-lg tracking-wide mb-1">Apelido</label>
                            <input type="text" id="apelido" name="apelido"
                                class="bg-[#f4edd7] text-black font-sans px-3 py-2 rounded-md outline-none h-10 w-full">
                        </div>

                        <div class="flex flex-col">
                            <label for="peso" class="text-lg tracking-wide mb-1">Peso</label>
                            <input type="text" id="peso" name="peso"
                                class="bg-[#f4edd7] text-black font-sans px-3 py-2 rounded-md outline-none h-10 w-full">
                        </div>

                        <div class="flex flex-col">
                            <label for="treinador" class="text-lg tracking-wide mb-1">Treinador/Academia</label>
                            <input type="text" id="treinador" name="treinador"
                                class="bg-[#f4edd7] text-black font-sans px-3 py-2 rounded-md outline-none h-10 w-full">
                        </div>

                        <div class="flex flex-col">
                            <label for="quantidadeLutas" class="text-lg tracking-wide mb-1">Quantidade de lutas</label>
                            <input type="number" id="quantidadeLutas" name="quantidadeLutas"
                                class="bg-[#f4edd7] text-black font-sans px-3 py-2 rounded-md outline-none h-10 w-full">
                        </div>

                        <button type="submit" class="bg-[#c24e54] text-white w-1/4 font-semibold py-2 rounded cursor-pointer
                                border-2 border-black hover:bg-[#a63f44] transition-colors shadow-[2px_2px_0px_rgba(0,0,0,1)] 
                                hover:shadow-none hover:translate-y-[2px] hover:translate-x-[2px]">
                            Enviar
                        </button>
                        <br>

                    </div>

                </form>

                <form action="/atualiza_perfil_corrida" method="POST" class="flex flex-col space-y-4">

                    <label class="flex items-center space-x-3 cursor-pointer w-max">
                        <input type="checkbox" id="check-corrida" name="esporte" value="corrida" class="appearance-none w-7 h-7 bg-[#f4edd7] rounded cursor-pointer 
                            checked:bg-[#f4edd7] checked:ring-2 checked:ring-green-500 flex items-center 
                            justify-center relative after:content-[''] after:hidden checked:after:block 
                            after:w-2.5 after:h-4 after:border-r-4 after:border-b-4 after:border-green-500 
                            after:rotate-45 after:-mt-1">
                        <span class="text-xl tracking-wide">Corrida</span>
                    </label>

                    <div id="campos-corrida" class="hidden flex-col space-y-4 ml-8 mt-2 w-full max-w-md text-[#9be7ff]">

                        <div class="flex flex-col">
                            <label for="nivel" class="text-lg tracking-wide mb-1">Nível</label>
                            <select id="nivel" name="nivel"
                                class="bg-[#f4edd7] text-black font-sans px-3 py-2 rounded-md outline-none h-10 w-full cursor-pointer">
                                <option value="" disabled selected>Selecione...</option>
                                <option value="inicainte">Iniciante</option>
                                <option value="intermediario">Intermediário</option>
                                <option value="avancado">Avançado</option>
                            </select>
                        </div>

                        <div class="mt-6">
                            <label class="block text-lg mb-2">
                                Qual é o seu recorde pessoal?
                            </label>

                            <div class="flex items-center gap-3">
                                <input type="number" placeholder="Distância em Km" id="distancia" name="distancia"
                                    class="w-40 px-3 py-2 rounded-md bg-[#f4edd7] text-black focus:outline-none">

                                <span class="text-white">em</span>

                                <input type="text" placeholder="Tempo (hh:mm:ss)" id="tempo" name="tempo"
                                    class="w-40 px-3 py-2 rounded-md bg-[#f4edd7] text-black focus:outline-none"
                                    pattern="^(([0-1]?[0-9]|2[0-3]):)?[0-5]?[0-9]:[0-5][0-9]$" value="00:00:00">

                            </div>
                        </div>
                        <button type="submit" class="bg-[#c24e54] text-white w-1/4 font-semibold py-2 rounded cursor-pointer
                                border-2 border-black hover:bg-[#a63f44] transition-colors shadow-[2px_2px_0px_rgba(0,0,0,1)] 
                                hover:shadow-none hover:translate-y-[2px] hover:translate-x-[2px]">
                            Enviar
                        </button>
                        <br>
                    </div>

                </form>



                <label class="flex items-center space-x-3 cursor-pointer w-max">
                    <input type="checkbox" id="check-voleibol" name="esporte" value="voleibol" class="appearance-none w-7 h-7 bg-[#f4edd7] rounded cursor-pointer checked:bg-[#f4edd7] checked:ring-2 
                        checked:ring-green-500 flex items-center justify-center relative after:content-[''] after:hidden 
                        checked:after:block after:w-2.5 after:h-4 after:border-r-4 after:border-b-4 after:border-green-500 
                        after:rotate-45 after:-mt-1">
                    <span class="text-xl tracking-wide">Voleibol</span>
                </label>
                <br>

                <div id="campos-voleibol" class="hidden flex-col space-y-4 ml-8 mt-2 w-full max-w-md ">
                    <form action="/atualiza_perfil_voleibolTreinador" method="POST" class="flex flex-col space-y-4">
                        <label class="flex items-center space-x-3 cursor-pointer w-max">
                            <input type="checkbox" id="check-treinador" name="voleibol_treinador" value="treinador"
                                class="appearance-none w-7 h-7 bg-[#f4edd7] rounded cursor-pointer checked:bg-[#f4edd7] 
                                checked:ring-2 checked:ring-green-500 flex items-center justify-center relative 
                                after:content-[''] after:hidden checked:after:block after:w-2.5 after:h-4 
                                after:border-r-4 after:border-b-4 after:border-green-500 after:rotate-45 
                                after:-mt-1">
                            <span class="text-xl tracking-wide">Treinador</span>
                        </label>

                        <div id="campos-treinador"
                            class="hidden flex-col space-y-4 ml-8 mt-2 w-full max-w-md text-[#ffe58f]">

                            <div class="flex flex-col">
                                <label for="nomeEquipe" class="text-lg tracking-wide mb-1">Nome da
                                    Equipe</label>
                                <input type="text" id="nomeEquipe" name="nomeEquipe"
                                    class="bg-[#f4edd7] text-black font-sans px-3 py-2 rounded-md outline-none h-10 w-full">
                            </div>

                            <div class="flex flex-col">
                                <label for="categoria" class="text-lg tracking-wide mb-1">Categoria</label>
                                <select id="categoria" name="categoria"
                                    class="bg-[#f4edd7] text-black font-sans px-3 py-2 rounded-md outline-none h-10 w-full cursor-pointer">
                                    <option value="" disabled selected>Selecione...</option>
                                    <option value="adultoMasculino">Adulta - Masculino</option>
                                    <option value="adultoFeminino">Adulta - Feminino</option>
                                    <option value="infantoMasculino">Infanto - Masculino</option>
                                    <option value="infantoFeminino">Infanto - Feminino</option>
                                    <option value="juvenilMasculino">Juvenil - Masculino</option>
                                    <option value="juvenilFeminino">Juvenil - Feminino</option>
                                </select>
                            </div>

                            <button type="submit" class="bg-[#c24e54] text-white w-1/4 font-semibold py-2 rounded cursor-pointer
                                border-2 border-black hover:bg-[#a63f44] transition-colors shadow-[2px_2px_0px_rgba(0,0,0,1)] 
                                hover:shadow-none hover:translate-y-[2px] hover:translate-x-[2px]">
                                Enviar
                            </button>
                    </form>
                    <br>
                </div>

                <label class="flex items-center space-x-3 cursor-pointer w-max">
                    <input type="checkbox" id="check-jogador" name="voleibol_jogador" value="jogador" class="appearance-none w-7 h-7 bg-[#f4edd7] rounded cursor-pointer checked:bg-[#f4edd7] 
                        checked:ring-2 checked:ring-green-500 flex items-center justify-center relative after:content-[''] 
                        after:hidden checked:after:block after:w-2.5 after:h-4 after:border-r-4 after:border-b-4 
                        after:border-green-500 after:rotate-45 after:-mt-1">
                    <span class="text-xl tracking-wide">Jogador</span>
                </label>

                <div id="campos-jogador" class="hidden flex-col  space-y-4 ml-8 mt-2 w-full max-w-md text-[#ffe58f] ">
                    <form action="/atualiza_perfil_voleibolJogador" method="POST" class="flex flex-col space-y-4">

                        <div class="flex flex-col">
                            <label for="posicao" class="text-lg tracking-wide mb-1">Posição</label>
                            <select id="posicao" name="posicao"
                                class="bg-[#f4edd7] text-black font-sans px-3 py-2 rounded-md outline-none h-10 w-full cursor-pointer">
                                <option value="" disabled selected>Selecione...</option>
                                <option value="levantador">Levantador</option>
                                <option value="oposto">Oposto</option>
                                <option value="ponteiro">Ponteiro</option>
                                <option value="central">Central</option>
                                <option value="libero">Líbero</option>
                            </select>
                        </div>

                        <div class="flex flex-col">
                            <label for="tamanho" class="text-lg tracking-wide mb-1">Tamanho</label>
                            <input type="text" id="tamanho" name="tamanho"
                                class="bg-[#f4edd7] text-black font-sans px-3 py-2 rounded-md outline-none h-10 w-full">
                        </div>

                        <div class="flex flex-col">
                            <label for="tempo" class="text-lg tracking-wide mb-1">Joga voleibol a
                                quanto tempo</label>
                            <select id="tempo" name="tempo"
                                class="bg-[#f4edd7] text-black font-sans px-3 py-2 rounded-md outline-none h-10 w-full cursor-pointer">
                                <option value="" disabled selected>Selecione...</option>
                                <option value="menos_1_ano">Menos de 1 ano</option>
                                <option value="1_a_3_anos">De 1 a 3 anos</option>
                                <option value="3_a_5_anos">De 3 a 5 anos</option>
                                <option value="mais_5_anos">Mais de 5 anos</option>
                            </select>
                        </div>
                        <button type="submit" class="bg-[#c24e54] text-white w-1/4 font-semibold py-2 rounded cursor-pointer
                                border-2 border-black hover:bg-[#a63f44] transition-colors shadow-[2px_2px_0px_rgba(0,0,0,1)] 
                                hover:shadow-none hover:translate-y-[2px] hover:translate-x-[2px]">
                            Enviar
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    
    <%- include('../mensagens') %>

</body>
<script>
    const checkBoxe = document.getElementById('check-boxe');
    const camposBoxe = document.getElementById('campos-boxe');
    const checkCorrida = document.getElementById('check-corrida');
    const camposCorrida = document.getElementById('campos-corrida');
    const checkVoleibol = document.getElementById('check-voleibol');
    const camposVoleibol = document.getElementById('campos-voleibol');
    const checkTreinador = document.getElementById('check-treinador');
    const camposTreinador = document.getElementById('campos-treinador');
    const checkJogador = document.getElementById('check-jogador');
    const camposJogador = document.getElementById('campos-jogador');

    checkBoxe.addEventListener('change', function () {
        if (this.checked) {
            camposBoxe.classList.remove('hidden');
            camposBoxe.classList.add('flex');
        } else {
            camposBoxe.classList.add('hidden');
            camposBoxe.classList.remove('flex');
        }
    });

    checkCorrida.addEventListener('change', function () {
        if (this.checked) {
            camposCorrida.classList.remove('hidden');
            camposCorrida.classList.add('flex');
        } else {
            camposCorrida.classList.add('hidden');
            camposCorrida.classList.remove('flex');
        }
    });

    checkVoleibol.addEventListener('change', function () {
        if (this.checked) {
            camposVoleibol.classList.remove('hidden');
            camposVoleibol.classList.add('flex');
        } else {
            camposVoleibol.classList.add('hidden');
            camposVoleibol.classList.remove('flex');
        }
    });

    checkTreinador.addEventListener('change', function () {
        if (this.checked) {
            camposTreinador.classList.remove('hidden');
            camposTreinador.classList.add('flex');
        } else {
            camposTreinador.classList.add('hidden');
            camposTreinador.classList.remove('flex');
        }
    });

    checkJogador.addEventListener('change', function () {
        if (this.checked) {
            camposJogador.classList.remove('hidden');
            camposJogador.classList.add('flex');
        } else {
            camposJogador.classList.add('hidden');
            camposJogador.classList.remove('flex');
        }
    });
</script>

</html>