<!DOCTYPE html>
<html lang="pt-br">

<head> <%- include('../head'); %> </head>

<body class="bg-gradient-to-b from-[#e0fcff] to-white min-h-screen flex flex-col">
    <header> <%- include('../menu'); %> </header>
    <main class="md:p-12 font-serif text-gray-900 flex-1">
        <div class="max-w-4xl mx-auto top-1">

            <h1 class="text-4xl text-[#1a83b8] mb-6 tracking-wide drop-shadow-md font-semibold">
                Detalhes do Campeonato
            </h1>

            <div class="bg-[#f5ebd4] rounded-lg shadow-lg p-6 md:p-8 flex flex-col md:flex-row gap-8 ">
                <div class="md:w-1/3 flex flex-col items-center">
                    <img src="/imagens/<%= dadosCampeonatos.imagem %>" alt="Imagem do Campeonato"
                        class="w-full h-auto object-cover border border-black shadow-sm mb-4">
                </div>

                <div class="md:w-2/3 flex flex-col justify-between text-[#1a83b8] ">
                    <div>
                        <h2 class="text-3xl font-bold mb-6 border-b border-gray-400 pb-2">
                            <%= dadosCampeonatos.nome %>
                        </h2>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-lg">
                            <p><span class="font-bold text-black">Esporte:</span>
                                <%= dadosCampeonatos.esporte %>
                            </p>
                            <p><span class="font-bold text-black">Organizador:</span>
                                <%= dadosCampeonatos.organizador.nome %>
                            </p>
                            <p><span class="font-bold text-black">Data:</span>
                                <%= dadosCampeonatos.data.toLocaleDateString('pt-BR', { 
                                    day: '2-digit' , 
                                    month: 'long' ,
                                    year: 'numeric' }) %>
                            </p>
                            <p><span class="font-bold text-black">Local:</span>
                                <%= dadosCampeonatos.localizacao %>
                            </p>
                            <p><span class="font-bold text-black">Limite de Inscritos:</span>
                                <%= dadosCampeonatos.inscricoes %>
                            </p>

                             <p><span class="font-bold text-black">Categoria:</span>
                                    <% const categorias = {
                                        'adultoMasculino': 'Adulta - Masculino',
                                        'adultoFeminino': 'Adulta - Feminino',
                                        'infantoMasculino': 'Infanto - Masculino',
                                        'infantoFeminino': 'Infanto - Feminino',
                                        'juvenilMasculino': 'Juvenil - Masculino',
                                        'juvenilFeminino': 'Juvenil - Feminino',
                                        'palha': 'Peso Palha - até 47,63 kg',
                                        'moscaLigeiro': 'Peso Mosca Ligeiro - até 48,99 kg',
                                        'mosca': 'Peso Mosca - até 50,80 kg',
                                        'supermosca': 'Peso Supermosca - até 52,16 kg',
                                        'galo': 'Peso Galo - até 53,42 kg',
                                        'supergalo': 'Peso Super Galo - até 55,34 kg',
                                        'pena': 'Peso Pena - até 57,15 kg',
                                        'superpena': 'Peso Super Pena - até 58,97 kg',
                                        'leve': 'Peso Leve - até 61,23 kg',
                                        'superleve': 'Peso Super Leve - até 63,50 kg',
                                        'meioMedio': 'Peso Meio-Médio - até 66,68 kg',
                                        'superMeioMedio': 'Peso Super Meio-Médio - até 69,85 kg',
                                        'medio': 'Peso Médio - até 72,58 kg',
                                        'superMedio': 'Peso Super Médio - até 76,20 kg',
                                        'meioPesado': 'Peso Meio-Pesado - até 79,38 kg',
                                        'cruzador': 'Peso Cruzador - até 90,71 kg',
                                        'ponte': 'Peso Ponte - até 101,60 kg',
                                        'pesado': 'Peso Pesado - mais de 90,71 kg',
                                        '100m': 'Velocidade - 100m',
                                        '200m': 'Velocidade - 200m',
                                        '400m': 'Velocidade - 400m',
                                        '4x100m': 'Revezamento - 4x100m',
                                        '4x400m': 'Revezamento - 4x400m',
                                        '800m': 'Meio-Fundo - 800m',
                                        '1500m': 'Meio-Fundo - 1.500m',
                                        '5000m': 'Fundo - 5.000m',
                                        '10000m': 'Fundo - 10.000m',
                                        '110mBarreiras': 'Barreiras e Obstáculos - 110m com barreiras',
                                        '3000mObstaculos': 'Barreiras e Obstáculos - 3.000m com obstáculos',
                                        '5km': 'Corrida de Rua - 5 km',
                                        '10km': 'Corrida de Rua - 10 km',
                                        'meiaMaratona': 'Corrida de Rua - Meia Maratona (21,097 km)',
                                        'maratona': 'Corrida de Rua - Maratona (42,195 km)',
                                        'ultramaratona': 'Corrida de Rua - Ultramaratona (acima de 42,195 km)'
                                    }; %>
                                    <%= categorias[dadosCampeonatos.categoria] || dadosCampeonatos.categoria %>
                                </p>

                            <div
                                class="col-span-1 md:col-span-2 mt-2 bg-[#e6dcbf] p-3 border border-gray-300 inline-block w-max ">
                                <p><span class="font-bold text-black">Inscritos:</span>
                                    <%= inscritosCampeonato %>
                                </p>
                            </div>

                        </div>
                    </div>

                    <div class="mt-10 flex flex-wrap gap-4 justify-end">
                        <a href="/campeonato"
                            class="bg-[#ffe58f] rounded-lg text-[#1a83b8] font-semibold px-6 py-2 border-2 border-black hover:bg-[#fce597] transition-colors 
                            shadow-[2px_2px_0px_rgba(0,0,0,1)] hover:shadow-none hover:translate-y-[2px] hover:translate-x-[2px]">
                            Voltar
                        </a>
                        <a href="/inscrever/<%=dadosCampeonatos.id %>">
                            <button
                                class="bg-[#c24e54] rounded-lg font-semibold cursor-pointer text-white px-6 py-2 border-2 border-black hover:bg-[#a63f44] 
                                transition-colors shadow-[2px_2px_0px_rgba(0,0,0,1)] hover:shadow-none hover:translate-y-[2px] hover:translate-x-[2px]">
                                Inscrever-se
                            </button>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <%- include('../mensagens') %>
</body>

</html>