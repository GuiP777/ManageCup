<!DOCTYPE html>
<html lang="pt-br">

<head>
    <%- include('../head'); %>
</head>

<body class="bg-gradient-to-b from-[#e0fcff] to-white min-h-screen flex flex-col">

    <header>
        <%- include('../menu'); %>
    </header>

    <main class="p-6 flex flex-1 justify-center items-start pt-10 font-serif">

        <div class="bg-[#1a83b8] w-full max-w-6xl rounded-2xl p-8 shadow-2xl border border-white/20">

            <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-10 gap-5">
                <div>

                    <h1 class="text-[#f4edd7] text-4xl font-semibold mt-2">
                        Campeonatos
                    </h1>

                    <p class="text-white/90 mt-2 max-w-xl">
                        Consulte os campeonatos cadastrados, filtre por modalidade esportiva e realize sua inscrição de
                        forma simples e organizada.
                    </p>
                </div>

                <a href="/cadastroCampeonato">
                    <button class="bg-[#ffe58f] text-[#1a83b8] border-2 cursor-pointer border-black 
                            rounded-lg px-6 py-2 hover:bg-[#fce597] transition font-semibold
                            shadow-[2px_2px_0px_rgba(0,0,0,1)] hover:shadow-none hover:translate-y-[2px] 
                            hover:translate-x-[2px]">
                        + Criar Campeonato
                    </button>
                </a>
            </div>

            <div class="bg-[#f4edd7] rounded-2xl p-6 mb-8 shadow-xl border-2 border-black/20">

                <h2 class="text-[#1a83b8] text-xl font-bold mb-4">
                    Buscar campeonatos
                </h2>
                <form action="/filtrarCampeonatos" method="GET">

                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">

                        <div class="flex flex-col">
                            <label class="text-black font-semibold mb-1">Nome</label>
                            <input type="text" name="nome" placeholder="Digite o nome do campeonato"
                                class="border-2 border-black rounded-lg px-4 py-2 bg-white/30 text-black placeholder-black/60 shadow-sm">
                        </div>

                        <div class="flex flex-col">
                            <label class="text-black font-semibold mb-1">Esporte</label>
                            <select name="esporte"
                                class="border-2 border-black rounded-lg px-4 py-2 bg-white/30 text-black shadow-sm">
                                <option value="">Todos os esportes</option>
                                <option value="voleibol">Voleibol</option>
                                <option value="boxe">Boxe</option>
                                <option value="corrida">Corrida</option>
                            </select>
                        </div>

                        <button type="submit" class="bg-[#ffe58f] text-[#1a83b8] border-2 border-black rounded-lg px-5 py-2 cursor-pointer 
                        hover:bg-[#fce597] transition shadow-[2px_2px_0px_rgba(0,0,0,1)] hover:shadow-none 
                        hover:translate-y-[2px] hover:translate-x-[2px]-md font-semibold ">
                            Filtrar
                        </button>
                        <a href="/campeonato" class="bg-[#d1d5db] text-[#1a83b8] text-center border-2 border-black rounded-lg px-5 py-2 cursor-pointer 
                        hover:bg-gray-200 transition shadow-[2px_2px_0px_rgba(0,0,0,1)] hover:shadow-none 
                        hover:translate-y-[2px] hover:translate-x-[2px] font-semibold">
                            Limpar filtros

                        </a>
                    </div>
                </form>
            </div>

            <div class="flex flex-col gap-5">

                <% dadosCampeonatos.forEach(function(campeonato){ %>

                    <div
                        class="bg-[#f4edd7] rounded-2xl p-5 flex flex-col md:flex-row justify-between items-center shadow-xl border-2 border-black/20">
                        <div class="flex flex-col md:flex-row gap-5 items-center w-full md:w-auto">
                            <img src="/imagens/<%= campeonato.imagem %>" alt="<%= campeonato.nome %>"
                                class="w-40 h-28 object-cover rounded-xl shadow-md border-2 border-black/40">

                            <div class="text-black">
                                <h2 class="text-2xl font-bold text-[#1a83b8] mb-2">
                                    <%= campeonato.nome %>
                                </h2>

                                <p class="text-lg text-[#1a83b8]">
                                    <span class="font-semibold text-black">Esporte:</span>
                                    <%= campeonato.esporte %>
                                </p>

                                <p class="text-lg text-[#1a83b8]">
                                    <span class="font-semibold text-black">Organizador:</span>
                                    <%= campeonato.organizador %>
                                </p>

                                <p class="text-lg text-[#1a83b8]">
                                    <span class="font-semibold text-black">Inscritos:</span>
                                    <%= campeonato.inscritosCamp.length %>
                                </p>
                            </div>
                        </div>

                        <div class="flex flex-col gap-3 mt-5 md:mt-0 min-w-[170px]">

                            <a href="/inscrever/<%= campeonato.id %>">
                                <button
                                    class="bg-[#c24e54] text-white border-2 border-black rounded-lg px-5 py-2 
                                    hover:bg-[#a63f44] transition shadow-[2px_2px_0px_rgba(0,0,0,1)] hover:shadow-none 
                                    hover:translate-y-[2px] hover:translate-x-[2px] w-full cursor-pointer font-semibold">
                                    Inscreva-se
                                </button>
                            </a>

                            <a href="/infoCampeonato/<%= campeonato.id %>">
                                <button
                                    class="bg-[#ffe58f] text-[#1a83b8] border-2 border-black rounded-lg px-5 py-2 
                                    hover:bg-[#fce597] transition shadow-[2px_2px_0px_rgba(0,0,0,1)] hover:shadow-none 
                                    hover:translate-y-[2px] hover:translate-x-[2px] w-full cursor-pointer font-semibold">
                                    Saiba mais
                                </button>
                            </a>

                        </div>

                    </div>

                    <% }) %>

            </div>

        </div>

    </main>

    <%- include('../mensagens') %>
</body>

</html>